# NOX Beauty Space — Apache rules (production)

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8
ErrorDocument 404 /index.php?route=404-not-found

<IfModule mod_rewrite.c>
RewriteEngine On

# --- One address for the whole site: HTTPS and no "www." (duplicate hosts split Google ranking) ---
# Local development hosts are left alone.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !\.(test|localhost|local)(:\d+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# --- /index.php and /pl/ are duplicates of the home page ---
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# --- Security: only public entry points are reachable from the web ---
# Hidden/service folders and anything that is not a public asset return 404
# (database dumps, setup scripts, docs, .git, PHPMailer, password notes...).
RewriteRule ^(\.git|\.claude|\.osp|node_modules|database|PHPMailer|components|pages)(/|$) - [R=404,L,NC]
# Never execute scripts from the assets folder (e.g. a disguised upload)
RewriteRule ^assets/.*\.(php[0-9]?|phtml|phar)$ - [R=404,L,NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} !^/(assets/|favicon\.ico$|index\.php$|send_form\.php$|admin/(index\.php)?$|google[0-9a-f]+\.html$|BingSiteAuth\.xml$) [NC]
RewriteRule ^ - [R=404,L]

# --- Front controller ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]
</IfModule>

# --- Compression (faster pages = better Core Web Vitals) ---
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# --- Browser caching: static files for a year (CSS/JS carry ?v= cache busters), HTML always fresh ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|jpe?g|png|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Security headers (also a trust signal for browsers and Google)
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Enable after HTTPS works on the live domain:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # The admin panel and form endpoint must never appear in Google
    <If "%{REQUEST_URI} =~ m#^/(admin|send_form\.php)#">
        Header always set X-Robots-Tag "noindex, nofollow"
    </If>
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>
